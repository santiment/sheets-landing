podTemplate(label: 'sheets-landing-production-deploy', nodeSelector: 'cpu.credits=no', containers: [
    containerTemplate(name: 'kubectl', image: 'lachlanevenson/k8s-kubectl:v1.13.10', command: 'cat', ttyEnabled: true),
    containerTemplate(name: 'docker', image: 'docker', ttyEnabled: true, command: 'cat', envVars: [
      envVar(key: 'DOCKER_BUILDKIT', value: '1'),
      envVar(key: 'DOCKER_HOST', value: 'tcp://docker-host-docker-host:2375')]),
    containerTemplate(name: 'awscli', image: 'mikesir87/aws-cli', ttyEnabled: true, command: 'cat', envVars: [
      envVar(key: 'AWS_DEFAULT_REGION', value: 'eu-central-1'),
      secretEnvVar(key: 'AWS_ACCESS_KEY_ID', secretName: 'sanbase-sheets-landing-uploader-env', secretKey: 'awsAccessKeyId'),
      secretEnvVar(key: 'AWS_SECRET_ACCESS_KEY', secretName: 'sanbase-sheets-landing-uploader-env', secretKey: 'awsSecretAccessKey'),
    ])
]) {
  node('sheets-landing-production-deploy') {
    stage('Update deployment') {
      git url: 'https://github.com/santiment/sheets-landing/', credentialsId:'GitHubCheckoutCreds'
      def gitCommit = sh(returnStdout: true, script: "git rev-parse HEAD").trim()

      withCredentials([
          string(
            credentialsId: 'aws_account_id',
            variable: 'aws_account_id'
          )
        ]){
        
        def awsRegistry = "${env.aws_account_id}.dkr.ecr.eu-central-1.amazonaws.com"
        def sourceImage = "${awsRegistry}/sheets-landing"
        def taggedSource = "${sourceImage}:${gitCommit}"

        /* Tag the deployed image */
        container('docker') {
          
          def timestampTag = "stage-${env.TIMESTAMP_IMAGE_TAG}"
          def taggedStage = "${sourceImage}:production"
          def timestamped = "${sourceImage}:${timestampTag}"
          
          docker.withRegistry("https://${awsRegistry}", "ecr:eu-central-1:ecr-credentials") {
            sh "docker pull ${taggedSource}"
            sh "docker tag ${taggedSource} ${taggedStage}"
            sh "docker tag ${taggedSource} ${timestamped}"
            sh "docker push ${taggedStage}"
            sh "docker push ${timestamped}"
            /* Extract static assets for upload in s3 */
            sh "mkdir -p artifacts"
            sh "docker create --name sheets-landing-temp ${taggedSource}"
            sh "docker cp sheets-landing-temp:/app/public ./artifacts/"
            sh "docker rm sheets-landing-temp"
          }
        }
      }
    }
    
    stage('Copy assets to S3') {
      container('awscli') {
        sh 'echo \'window.env = { BACKEND_URL: "https://api.santiment.net" };\' > ./artifacts/public/env.js'
        sh 'cd ./artifacts/public/ && aws s3 sync . s3://sheets-production.santiment.net/ --exclude index.html'
        sh 'aws s3 cp ./artifacts/public/index.html s3://sheets-production.santiment.net/index.html --metadata-directive REPLACE --cache-control max-age=0,no-cache,no-store,must-revalidate --content-type text/html'
        }
    }
    
  }
}
