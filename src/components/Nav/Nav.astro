---
import CtaButton from "$components/CtaButton.svelte"

import Link from "./Link.svelte"
import MobileNav from "./MobileNav/MobileNav.svelte"
import ProductsButton from "./ProductsButton.svelte"
import { links } from "./utils"

import Logo from "./assets/logo.svg"
---

<nav
  class="container flex h-[70px] items-center justify-between md:max-w-[800px]"
>
  <div class="flex items-center gap-8">
    <a href="/" aria-label="Go to homepage">
      <Logo width="124" height="40" />
    </a>

    <div class="md:hidden">
      <ProductsButton client:load />
    </div>
  </div>

  <div class="flex items-center gap-5 text-sm md:hidden">
    {
      links.map(({ href, label, isExternal = false }) => (
        <Link {href} {label} {isExternal} />
      ))
    }

    <CtaButton client:load />
  </div>

  <MobileNav client:idle />
</nav>
