---
import Button from "san-webkit-next/ui/core/Button"

import girlImage from "./assets/girl.svg?url"
---

<section class="mb-0 flex h-[550px] w-full items-start justify-center">
  <div
    class="h-full w-full bg-[length:auto,auto] pt-[50px] text-center xs:bg-[length:auto,contain] xs:pt-[170px]"
    style={`background-image: linear-gradient(180deg, white 0%, rgba(255,255,255,0) 27%, rgba(255,255,255,0) 73%, white 100%), url('${girlImage}'); background-repeat: no-repeat, no-repeat; background-position: 0% 0%, 37% 73%;`}
  >
    <h2 class="text-4xl font-semibold text-rhino sm:text-3xl">
      Ready to get started?
    </h2>

    <p class="mx-auto mb-6 mt-4 text-base text-fiord">
      Click below to access the Santiment API or join the Discord<br
        class="xs:hidden"
      />
      channel to share your solutions with the world
    </p>

    <Button
      href="https://app.santiment.net/sign-up"
      target="_blank"
      variant="fill"
      accent="custom"
      size="lg"
      class="press inline-flex h-[50px] px-[45px]"
    >
      Get access
    </Button>
  </div>
</section>
