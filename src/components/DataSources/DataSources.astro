---
import { Image } from "astro:assets"
import Button from "san-webkit-next/ui/core/Button"

import { advantages } from "./assets/data"
import DataSourceCard from "./DataSourceCard.astro"

import interest from "$assets/interest.svg"
---

<section id="metrics" class="mb-[165px] sm:mb-20">
  <div
    class="grid gap-6 [grid-template-areas:'chain_social_financial'_'chain_social_financial'_'chain_social_developer'_'interest_interest_developer'] sm:[grid-template-areas:'chain'_'social'_'financial'_'developer'_'interest']"
  >
    {advantages.map((advantage) => <DataSourceCard {...advantage} />)}

    <div
      class="relative rounded bg-athens p-8 xs:flex xs:flex-col xs:items-center xs:pt-[300px]"
      style="grid-area:interest"
    >
      <h2 class="text-xl font-semibold">Sounds interesting?</h2>

      <p
        class="mb-5 mt-3 max-w-[270px] text-base text-fiord md:text-sm xs:max-w-full xs:text-center"
      >
        Create your custom solutions by using our API and comprehensive set of
        data
      </p>

      <Button
        href="https://app.santiment.net/"
        variant="fill"
        accent="custom"
        size="lg"
        class="w-fit px-11 xs:h-[50px] xs:w-full xs:justify-center"
      >
        Try free now
      </Button>

      <Image
        src={interest}
        alt=""
        aria-hidden="true"
        class="pointer-events-none absolute right-[9%] top-[45px] h-[222px] w-[200px] md:right-0 xs:inset-x-0 xs:mx-auto"
      />
    </div>
  </div>
</section>
