---
import { Image } from "astro:assets"
import type { SvgComponent } from "astro/types"
import { cn } from "san-webkit-next/ui/utils"

type Props = {
  title: string
  icon?: SvgComponent & ImageMetadata
  class?: string
}

const { title, icon, class: className } = Astro.props
---

<div
  class={cn([
    "absolute flex items-center gap-3.5 rounded-lg border border-athens bg-white px-4 py-3.5 shadow-panel",
    className,
  ])}
>
  <slot name="before" />
  {icon && <Image src={icon} alt="" />}
  <span class="whitespace-nowrap text-lg text-rhino">{title}</span>
  <slot />
</div>
