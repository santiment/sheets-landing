---
import { Image } from "astro:assets"
import Svg from "san-webkit-next/ui/core/Svg"

import CodePanel from "../CodePanel.astro"
import FloatingPanel from "../FloatingPanel/FloatingPanel.astro"

import graph from "./assets/graph.svg"

const changes = [
  { title: "$FTT", pos: "top-[98px] -left-[43px]", value: 7.26 },
  { title: "$IOTA", pos: "top-[62px] left-[248px]", value: 9.82 },
  { title: "$DOGE", pos: "top-[143px] left-[443px]", value: 3.54 },
]
---

<CodePanel class="h-[430px]">
  <Image
    class="absolute -bottom-[129px] -left-[110px] max-w-none"
    src={graph}
    alt=""
  />

  {
    changes.map(({ title, pos, value }) => (
      <FloatingPanel class={`${pos} gap-12`} title={title}>
        <div class="flex items-center gap-1">
          <span class="flex size-3 items-center justify-center rounded-full bg-lima-light-1">
            <Svg id="triangle" w={6} h={4} class="fill-blue" />
          </span>
          <span class="text-xs text-blue">{value}%</span>
        </div>
      </FloatingPanel>
    ))
  }
</CodePanel>
