---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"
import {
  devactIcon,
  financialIcon,
  onchainIcon,
  socialIcon,
} from "../FloatingPanel/assets"
import FloatingPanel from "../FloatingPanel/FloatingPanel.astro"

import eth from "../FloatingPanel/assets/eth.png"
import graphImg from "./assets/graph.svg?url"
import warningImg from "./assets/warning.svg?url"
import combinedTemplate from "$assets/combined-template.svg?url"
---

<CodePanel class="mr-5 w-[60%]">
  <div
    class="relative mx-auto h-[365px] w-[94%]"
    style={`background: url('${graphImg}') no-repeat 25%; background-size: contain;`}
  >
    <FloatingPanel
      class="left-[115px] top-[15px]"
      title="Financial"
      icon={financialIcon}
    />
    <FloatingPanel
      class="-bottom-[20px] right-[60px]"
      title="On-chain"
      icon={onchainIcon}
    />
    <FloatingPanel
      class="left-[190px] top-[180px]"
      title="Social"
      icon={socialIcon}
    />
    <FloatingPanel
      class="-left-[30px] bottom-[94px]"
      title="Dev. activity"
      icon={devactIcon}
    />

    <div
      class="absolute -right-[50px] top-[48px] flex h-[140px] w-[263px] flex-col justify-end rounded-lg p-[30px_24px_18px_20px]"
      style={`background: url('${combinedTemplate}') no-repeat;`}
    >
      <div
        class="absolute right-1 top-1 z-[2] size-[35px] rounded-full bg-[center_49%] bg-no-repeat"
        style={`background-color: var(--green-light-3); background-image: url('${warningImg}');`}
      >
      </div>

      <div
        class="pointer-events-none absolute inset-x-0 bottom-0 h-[120px] rounded-lg shadow-popup"
      >
      </div>

      <div class="mb-4 flex items-center gap-3">
        <Image src={eth} alt="Ethereum" />
        <h3 class="text-sm text-rhino">Ethereum</h3>
      </div>

      <h4 class="text-sm text-waterloo">
        Ethereum price was decreased by <b class="mx-1 font-bold text-rhino"
          >$ 70.51</b
        > in 24 hours
      </h4>
    </div>
  </div>
</CodePanel>
