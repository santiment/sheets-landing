---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"
import {
  devactIcon,
  financialIcon,
  onchainIcon,
  socialIcon,
} from "../FloatingPanel/assets"
import FloatingPanel from "../FloatingPanel/FloatingPanel.astro"

import eth from "../FloatingPanel/assets/eth.png"
import graphImg from "./assets/graph.svg?url"
import WarningIcon from "./assets/warning.svg"
import combinedTemplate from "$assets/combined-template.svg?url"
---

<CodePanel class="mr-5 w-[60%]">
  <div
    class="mx-auto h-[365px] w-[94%]"
    style={`background-image: url('${graphImg}'); background-repeat: no-repeat; background-position: 25%; background-size: contain;`}
  >
    <FloatingPanel
      class="left-[115px] top-[15px]"
      title="Financial"
      icon={financialIcon}
    />
    <FloatingPanel
      class="-left-[30px] bottom-[94px]"
      title="On-chain"
      icon={onchainIcon}
    />
    <FloatingPanel
      class="left-[190px] top-[180px]"
      title="Social"
      icon={socialIcon}
    />
    <FloatingPanel
      class="-bottom-5 right-[60px]"
      title="Dev. activity"
      icon={devactIcon}
    />

    <div
      class="absolute -right-[50px] top-12 z-[10] flex h-[140px] w-[263px] flex-col justify-end rounded-lg p-[30px_24px_18px_20px]"
      style={`background-image: url('${combinedTemplate}'); background-repeat: no-repeat;`}
    >
      <div
        class="absolute right-1 top-1 z-[2] flex size-[35px] items-center justify-center rounded-full"
        style="background-color: var(--sheets-accent);"
      >
        <WarningIcon width={16} height={16} />
      </div>

      <div
        class="pointer-events-none absolute bottom-0 left-0 h-[120px] w-[249px] rounded-lg shadow-popup"
      >
      </div>

      <div class="mb-4 flex items-center gap-3">
        <Image src={eth} alt="Ethereum" />
        <p class="text-sm text-rhino">Ethereum</p>
      </div>

      <p class="text-sm text-waterloo">
        Ethereum price was decreased by <b class="mx-1 font-semibold text-rhino"
          >$ 70.51</b
        > in 24 hours
      </p>
    </div>
  </div>
</CodePanel>
