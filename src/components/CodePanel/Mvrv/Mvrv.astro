---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"
import FloatingPanel from "../FloatingPanel/FloatingPanel.astro"

import graph from "./assets/graph.svg"
---

<CodePanel class="w-[60%]">
  <Image class="absolute left-[-98px] top-[-58px]" src={graph} alt="" />

  <FloatingPanel class="-left-[28px] top-[265px]" title="Danger zone">
    <div slot="before" class="h-5 w-5 rounded-full bg-red"></div>
  </FloatingPanel>

  <FloatingPanel class="-right-[24px] top-[66px]" title="Opportunity zone">
    <div slot="before" class="h-5 w-5 rounded-full bg-green"></div>
  </FloatingPanel>
</CodePanel>
