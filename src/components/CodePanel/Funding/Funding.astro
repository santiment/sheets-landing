---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"
import FloatingPanel from "../FloatingPanel/FloatingPanel.astro"

import graph from "./assets/graph.svg"
---

<CodePanel class="w-[60%]">
  <Image
    class="absolute -left-[62px] -top-[45px] w-[125%]"
    src={graph}
    alt=""
  />

  <FloatingPanel class="-left-[27px] top-[301px]" title="Fear">
    <div slot="before" class="h-5 w-5 rounded-full bg-lima"></div>
  </FloatingPanel>

  <FloatingPanel class="left-[508px] top-[69px]" title="Greed">
    <div slot="before" class="h-5 w-5 rounded-full bg-red"></div>
  </FloatingPanel>
</CodePanel>
