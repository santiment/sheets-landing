---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"

import eth from "../FloatingPanel/assets/eth.png"
import graph from "./assets/graph.svg"
---

<CodePanel class="w-[60%]">
  <Image
    class="absolute -left-[43px] -top-[41px] w-[116%]"
    src={graph}
    alt=""
  />

  <div
    class="absolute left-[351px] top-[282px] flex size-12 items-center justify-center rounded-full border border-athens bg-white text-2xl drop-shadow-panel"
  >
    🐋
  </div>

  <div
    class="absolute left-[200px] top-[100px] rounded-lg border border-athens bg-white py-3.5 pl-[38px] pr-8 drop-shadow-panel"
  >
    <div
      class="absolute -left-5 -top-2.5 flex size-12 items-center justify-center rounded-full border border-athens bg-white text-2xl drop-shadow-panel"
    >
      🐋
    </div>
    <p class="mb-4 text-xs font-medium text-casper">Balance</p>
    <p class="text-xl font-semibold leading-tight">+ 15%</p>
  </div>

  <div
    class="absolute -right-[66px] top-[60px] w-[213px] rounded-lg border border-athens bg-white p-[18px_20px] drop-shadow-panel"
  >
    <div class="mb-4 flex items-center gap-3">
      <Image src={eth} alt="eth" />

      <p class="text-xs">Ethereum</p>
    </div>

    <p class="text-xs text-waterloo">
      Ethereum % 30-Day Total Cumulative: <b class="font-semibold text-black"
        >1.1862%</b
      >
    </p>
  </div>
</CodePanel>
