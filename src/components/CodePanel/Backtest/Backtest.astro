---
import { Image } from "astro:assets"
import Svg from "san-webkit-next/ui/core/Svg"

import CodePanel from "../CodePanel.astro"
import { btcIcon, ethCircleIcon, financialIcon } from "../FloatingPanel/assets"

import man from "$assets/ibis.jpg"
---

<CodePanel class="w-[60%]">
  <Image
    src={btcIcon}
    alt="btc"
    class="absolute left-10 top-10 rounded-full border-4 border-white shadow-panel"
  />

  <Image
    src={ethCircleIcon}
    alt="eth"
    class="absolute left-[300px] top-[220px] rounded-full border-4 border-white shadow-panel"
  />

  <div
    class="absolute -left-[38px] top-56 flex flex-col items-center rounded-lg bg-white p-[14px_20px] shadow-panel"
  >
    <div class="flex w-full items-center justify-between text-waterloo">
      <span>BTC / USD</span>

      <span class="flex items-center gap-1 text-blue">
        <Svg id="triangle" w={6} h={4} class="fill-blue" />
        7.26%
      </span>
    </div>

    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="192"
      height="40"
      fill="none"
      class="mt-4"
    >
      <path
        stroke="var(--blue, #5275FF)"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="1.5"
        d="M1 39C25.3 27.4 28.6 1 51.2 1c18.2 0 22.7 29 39.5 26.4 13.7-2.1 12.1-18 27.3-15.8 13.5 1.8 16.7 29.3 30.4 16.8 15.2-13.7 29-1 42.6-13.7"
      ></path>
    </svg>
  </div>

  <div
    class="absolute -right-[30px] top-[75px] flex items-start gap-4 rounded-lg bg-white p-[16px_20px] shadow-panel"
  >
    <Image src={financialIcon} alt="" class="-mt-1" />
    <div>
      <p class="mb-1.5 text-lg font-medium text-rhino">
        Ethereum price tracking
      </p>

      <p class="w-[250px] text-sm text-waterloo">
        Track the activity of selected address based on the Ethereum
      </p>
    </div>
  </div>

  <div class="absolute bottom-[33px] right-9 shadow-panel">
    <Image
      src={man}
      alt=""
      width={32}
      height={32}
      class="absolute left-3.5 top-1/2 size-8 -translate-y-1/2 rounded-full object-cover"
    />

    <input
      disabled
      placeholder="Update the status..."
      class="h-[62px] w-full rounded border border-porcelain bg-athens px-[57px] py-0 pr-20 text-sm text-mystic outline-none placeholder:text-casper"
    />

    <Svg
      id="smile"
      w={18}
      class="absolute right-6 top-1/2 -translate-y-1/2 fill-waterloo"
    />

    <svg
      xmlns="http://www.w3.org/2000/svg"
      width="17"
      height="17"
      fill="none"
      class="absolute right-[57px] top-1/2 -translate-y-1/2 fill-waterloo"
    >
      <path
        fill-rule="evenodd"
        d="M16.7.3a1 1 0 0 1 .25 1.03l-5 14.5a1 1 0 0 1-1.86.09l-3-6.5a1 1 0 0 1 .2-1.13l2.5-2.5a1 1 0 1 1 1.42 1.42l-2.01 2 1.67 3.61 3.52-10.2L4.18 6.12 6.4 7.16a1 1 0 1 1-.84 1.82L1.08 6.9a1 1 0 0 1 .1-1.86l14.5-5A1 1 0 0 1 16.7.3z"
        clip-rule="evenodd"></path>
    </svg>
  </div>

  <ul class="space-y-6 px-10 py-8">
    {
      [433, 197, 366, 473, 315, 447, 536, 238].map((w) => (
        <li class="h-5 rounded-full bg-porcelain" style={`width:${w}px`} />
      ))
    }
  </ul>
</CodePanel>
