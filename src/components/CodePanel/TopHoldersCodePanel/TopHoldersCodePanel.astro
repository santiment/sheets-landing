---
import { Image } from "astro:assets"

import CodePanel from "../CodePanel.astro"

import eth from "../FloatingPanel/assets/eth.png"
import graph from "./assets/graph.svg"
---

<CodePanel class="w-[60%]">
  <Image
    class="absolute left-[-43px] top-[-41px] w-[116%]"
    src={graph}
    alt=""
  />

  <div
    class="absolute left-[351px] top-[282px] flex size-12 items-center justify-center rounded-full border border-[#F1F3F9] bg-white text-2xl [filter:drop-shadow(0px_10px_40px_rgba(24,27,43,0.06))]"
  >
    🐋
  </div>

  <div
    class="absolute left-[200px] top-[100px] rounded-lg border border-[#F1F3F9] bg-white py-[14px] pl-[38px] pr-8 [filter:drop-shadow(0px_10px_40px_rgba(24,27,43,0.06))]"
  >
    <div
      class="absolute left-[-20px] top-[-10px] flex size-12 items-center justify-center rounded-full border border-[#F1F3F9] bg-white text-2xl [filter:drop-shadow(0px_10px_40px_rgba(24,27,43,0.06))]"
    >
      🐋
    </div>
    <h3 class="mb-4 text-xs font-medium text-casper">Balance</h3>
    <h2 class="text-xl font-semibold leading-tight">+ 15%</h2>
  </div>

  <div
    class="absolute right-[-66px] top-[60px] w-[213px] rounded-lg border border-[#F1F3F9] bg-white p-[18px_20px] [filter:drop-shadow(0px_10px_40px_rgba(24,27,43,0.06))]"
  >
    <div class="mb-4 flex items-center gap-3">
      <Image src={eth} alt="eth" />

      <h3 class="text-xs">Ethereum</h3>
    </div>

    <h4 class="text-xs text-waterloo">
      Ethereum % 30-Day Total Cumulative: <b class="font-semibold text-black"
        >1.1862%</b
      >
    </h4>
  </div>
</CodePanel>
