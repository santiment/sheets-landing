---
import { cn } from "san-webkit-next/ui/utils"

type Props = {
  class?: string
  interactive?: boolean
}

const { class: className, interactive = false } = Astro.props
---

<div
  aria-hidden={interactive ? undefined : "true"}
  class={cn(
    "relative mt-5 min-h-[400px] min-w-[600px] animate-float rounded-lg motion-reduce:animate-none border border-athens bg-white shadow-code md:hidden",
    className
  )}
>
  <div class="flex h-9 items-center gap-2.5 border-b border-athens px-3">
    <div class="size-3.5 rounded-full bg-porcelain"></div>
    <div class="size-3.5 rounded-full bg-porcelain"></div>
    <div class="size-3.5 rounded-full bg-porcelain"></div>
  </div>
  <slot />
</div>
