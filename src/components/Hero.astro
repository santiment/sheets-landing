---
import Button from "san-webkit-next/ui/core/Button"

import MainCodePanel from "$components/CodePanel/Main/Main.svelte"
---

<section class="relative mb-[165px] mt-[120px] flex flex-wrap justify-between">
  <div class="max-w-[480px] space-y-8 md:max-w-full">
    <h1 class="text-5xl font-bold text-rhino sm:text-4xl">
      Crypto Spreadsheets for Google Sheets
    </h1>

    <p class="max-w-[466px] text-xl text-waterloo">
      Get relevant access for on-chain, social development activity, prices and
      volume data
    </p>

    <div class="flex items-center gap-8">
      <Button
        href="https://academy.santiment.net/sansheets/setting-up/"
        variant="plain"
        target="_blank"
        class="h-[50px] rounded bg-sheets px-[39px] py-2.5 text-base text-white"
      >
        Get started
      </Button>

      <Button
        href="https://academy.santiment.net/sansheets/functions/"
        variant="plain"
        target="_blank"
        icon="arrow-right"
        iconOnRight
        iconSize={8}
        class="flex items-center gap-2 fill-sheets text-base text-sheets"
      >
        Documentation
      </Button>
    </div>
  </div>

  <MainCodePanel client:load />
</section>
