---
import firstImg from "./first.svg?url"
import secondImg from "./second.svg?url"

const audiences = [
  {
    image: firstImg,
    title: "For traders & investors",
    text: "Build models and backtest your strategies with the most comprehensive source of crypto data on the market. No data aggregation, no intermediaries.",
    position:
      "md:[background-position:92%_-53%] sm:[background-position:92%_-5%]",
  },
  {
    image: secondImg,
    title: "For researchers & journalists",
    text: "Investigate network activity, discover market patterns, and analyze stakeholder behavior with our clean, reliable data streams for 100s of digital assets.",
    position: "md:[background-position:92%_12%]",
  },
]
---

<section class="mb-[165px] space-y-8 sm:mb-20">
  {
    audiences.map(({ image, title, text, position }) => (
      <article
        style={`--bg-image: url('${image}')`}
        class:list={[
          "relative flex flex-col rounded-lg bg-mirage bg-no-repeat p-[40px_50px]",
          "[background-image:var(--bg-image)] [background-position:92%_55%]",
          "md:bg-contain md:pt-[150px] sm:p-[132px_24px_32px]",
          position,
        ]}
      >
        <h2 class="mb-4 text-xl font-semibold text-white">{title}</h2>

        <p class="max-w-[400px] text-base text-casper">{text}</p>
      </article>
    ))
  }
</section>

<style>
  article:before {
    content: "";
    display: block;
    position: absolute;
    width: 90%;
    height: 186px;
    left: 5%;
    top: 26px;
    z-index: -1;
    background-color: var(--mirage);
    opacity: 0.6;
    filter: blur(18px);
    border-radius: 8px;
  }
</style>
