---
import Audience from "$components/Audience/Audience.astro"
import DataSources from "$components/DataSources/DataSources.astro"
import FAQ from "$components/FAQ/FAQ.svelte"
import Footer from "$components/Footer.astro"
import GetStarted from "$components/GetStarted/GetStarted.astro"
import Hero from "$components/Hero.astro"
import SEO from "$components/SEO.astro"
import Templates from "$components/Templates/Templates.astro"
import Testimonials from "$components/Testimonials/Testimonials.astro"
import Layout from "$layouts/Layout.astro"

import waves from "$assets/waves.svg?url"
---

<Layout>
  <SEO slot="seo" />

  <div class="waves" style={`background-image: url('${waves}')`}></div>

  <div class="container md:max-w-[800px]">
    <Hero />
    <Audience />
    <DataSources />
    <Templates />
    <FAQ client:load />
    <Testimonials />
  </div>

  <GetStarted />

  <Footer />
</Layout>

<style>
  .waves {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 909px;
    background-repeat: no-repeat;
    background-position: top;
    background-size: cover;
    z-index: -1;
  }

  .waves::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 46%, white 100%);
  }
</style>
