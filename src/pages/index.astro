---
import Footer from "san-webkit-next/ui/app/Footer"

import ForWhom from "$components/Audience/Audience.astro"
import Advantages from "$components/DataSources/DataSources.astro"
import FAQ from "$components/FAQ/FAQ.svelte"
import ReadyToStart from "$components/GetStarted/GetStarted.astro"
import Hero from "$components/Hero.astro"
import SEO from "$components/SEO.astro"
import UseCases from "$components/Templates/Templates.astro"
import Testimonials from "$components/Testimonials/Testimonials.astro"
import Layout from "$layouts/Layout.astro"

import waves from "$assets/waves.svg?url"
---

<Layout>
  <SEO slot="seo" />

  <div class="waves" style={`background-image: url('${waves}')`}></div>

  <div class="container">
    <Hero />
    <ForWhom />
    <Advantages />
    <UseCases />
    <FAQ client:load />
    <Testimonials />
    <ReadyToStart />
  </div>

  <Footer style="--accent: var(--sheets)" />
</Layout>

<style>
  .waves {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 909px;
    background-repeat: no-repeat;
    background-position: top;
    background-size: cover;
    z-index: -1;
  }

  .waves::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0) 46%, white 100%);
  }
</style>
