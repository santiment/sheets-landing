  <section class="flex h-[50vh] flex-col items-center justify-center">
    <h1 class="mb-5 text-5xl font-bold text-rhino sm:text-4xl">NOT FOUND</h1>
    <p class="text-base">
      You just hit a route that doesn&#39;t exist... the sadness.
    </p>
  </section>

  <Footer />
</Layout>
